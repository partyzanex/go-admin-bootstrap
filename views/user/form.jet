{{ extends "../layouts/main.jet" }}

{{ block documentBody() }}

<div class="col-lg-7 col-md-10 mx-auto">
  {{ if isset(error) }}
    <div class="alert alert-danger">{{ error }}</div>
  {{ end }}
  <form action="{{ adminPath }}{{ formAction }}" method="post" id="user-form">
    {{ if isset(csrf_token) }}<input type="hidden" name="_csrf" value="{{ csrf_token }}">{{ end }}
    <input type="hidden" id="user-id" name="id" value="{{ user.ID }}">
    <div class="card">
      <div class="card-header">{{ isset(title) ? title : "User" }}</div>
      <div class="card-body py-3">
        <div class="row g-3">
          <div class="col-md-7">
            <label class="form-label form-label-sm mb-1">User Name</label>
            <input type="text" class="form-control" id="user-name" name="name" value="{{ user.Name }}" autocomplete="off">
          </div>
          <div class="col-md-5">
            <label class="form-label form-label-sm mb-1">User Role</label>
            <select class="form-select" id="user-role" name="role">
              <option value="owner"{{ user.Role == "owner" ? " selected" : "" }}>owner</option>
              <option value="root"{{ user.Role == "root" ? " selected" : "" }}>root</option>
              <option value="user"{{ user.Role == "user" ? " selected" : "" }}>user</option>
            </select>
          </div>
          <div class="col-md-7">
            <label class="form-label form-label-sm mb-1">User Login</label>
            <input type="text" class="form-control" id="user-login" name="login" value="{{ user.Login }}">
          </div>
          <div class="col-md-5">
            <label class="form-label form-label-sm mb-1">User Status</label>
            <select class="form-select" id="user-status" name="status">
              <option value="new"{{ user.Status == "new" ? " selected" : "" }}>new</option>
              <option value="active"{{ user.Status == "active" ? " selected" : "" }}>active</option>
              <option value="blocked"{{ user.Status == "blocked" ? " selected" : "" }}>blocked</option>
            </select>
          </div>
          <div class="col-md-7">
            <label class="form-label form-label-sm mb-1">User Password</label>
            <input type="password"
              class="form-control"
              id="user-password"
              name="password"
              value=""
              autocomplete="off"
              readonly
              onfocus="this.removeAttribute('readonly')"
            >
          </div>
        </div>
      </div>
      <div class="card-footer text-end" style="background:var(--surface);border-top:1px solid var(--border);">
        <button class="btn btn-success btn-sm" type="submit">Save</button>
      </div>
    </div>
  </form>
</div>

{{ end }}
