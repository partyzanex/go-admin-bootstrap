{{ block nav() }}
<nav class="navbar navbar-dark bg-info">
<div class="container-fluid">
  <div class="navbar-brand">
    <a href="{{ adminPath }}/" class="navbar-brand align-self-center">GoAdmin</a>
  </div>
  <div class="navbar-expand">
    <ul class="navbar-nav mr-0 my-0">
    {{ if isset(.User) }}
      {{ if .User.Role == "owner" || .User.Role == "root" }}
      <li class="nav-item"><a href="{{ adminPath }}/users" class="nav-link">Users</a></li>
      <li class="nav-item"><a href="{{ adminPath }}/audit" class="nav-link">Audit Log</a></li>
      {{ end }}
      <li class="nav-item">
        <form method="POST" action="{{ adminPath }}/logout" style="display:inline;">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}">
          <button type="submit" class="nav-link btn btn-link" style="padding:0;border:none;background:none;color:inherit;">Logout [{{ .User.Name }}]</button>
        </form>
      </li>
    {{ else }}
      <li class="nav-item"><a href="{{ adminPath }}/login" class="nav-link">Login</a></li>
    {{ end }}
    </ul>
  </div>
  </div>
</nav>
{{ end }}
