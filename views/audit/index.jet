{{ extends "../layouts/main.jet" }}
{{ import "../widgets/pagination.jet" }}

{{ block documentBody() }}

  {{ if isset(auditDisabled) && auditDisabled }}
    <div class="alert alert-warning">
      <strong>Audit logging is disabled.</strong> Set <code>Config.AuditLog</code> to enable it.
    </div>
  {{ else }}

  <div class="filter-bar">
    <form method="GET" action="{{ adminPath }}/audit">
      <div class="row g-2 align-items-end">
        <div class="col-lg-3 col-md-5">
          <select name="action" class="form-select">
            <option value="">All actions</option>
            <option value="login"{{ isset(actionFilter) && actionFilter == "login" ? ` selected` : `` }}>Login</option>
            <option value="logout"{{ isset(actionFilter) && actionFilter == "logout" ? ` selected` : `` }}>Logout</option>
            <option value="create_user"{{ isset(actionFilter) && actionFilter == "create_user" ? ` selected` : `` }}>Create user</option>
            <option value="update_user"{{ isset(actionFilter) && actionFilter == "update_user" ? ` selected` : `` }}>Update user</option>
            <option value="delete_user"{{ isset(actionFilter) && actionFilter == "delete_user" ? ` selected` : `` }}>Delete user</option>
          </select>
        </div>
        <div class="col-lg-3 col-md-4">
          <button type="submit" class="btn btn-primary me-1">Filter</button>
          <a href="{{ adminPath }}/audit" class="btn btn-secondary">Reset</a>
        </div>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover table-striped table-sm mb-0">
          <thead class="table-secondary">
            <tr>
              <th style="width: 170px;">Date</th>
              <th style="width: 180px;">Actor</th>
              <th style="width: 140px;">Action</th>
              <th style="width: 80px;">Entity ID</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
          {{ if isset(logs) && len(logs) > 0 }}
            {{ range _, entry := logs }}
            <tr>
              <td><small class="text-muted">{{ entry.GetDTCreated() }}</small></td>
              <td>
                {{ if entry.ActorLogin != "" }}
                  {{ entry.ActorLogin }}
                  {{ if entry.ActorID != 0 }}
                    <small class="text-muted">#{{ entry.ActorID }}</small>
                  {{ end }}
                {{ else }}
                  <span class="text-muted">&mdash;</span>
                {{ end }}
              </td>
              <td>
                {{ if entry.Action == "login" }}
                  <span class="badge bg-success">login</span>
                {{ else if entry.Action == "logout" }}
                  <span class="badge bg-secondary">logout</span>
                {{ else if entry.Action == "create_user" }}
                  <span class="badge bg-primary">create_user</span>
                {{ else if entry.Action == "update_user" }}
                  <span class="badge bg-warning text-dark">update_user</span>
                {{ else if entry.Action == "delete_user" }}
                  <span class="badge bg-danger">delete_user</span>
                {{ else }}
                  <span class="badge bg-secondary">{{ entry.Action }}</span>
                {{ end }}
              </td>
              <td class="text-muted small">
                {{ if entry.EntityID != 0 }}#{{ entry.EntityID }}{{ else }}&mdash;{{ end }}
              </td>
              <td class="small">
                {{ if isset(entry.Meta) }}
                  {{ range key, val := entry.Meta }}
                    <span class="text-muted">{{ key }}:</span> {{ val }}&nbsp;
                  {{ end }}
                {{ end }}
              </td>
            </tr>
            {{ end }}
          {{ else }}
            <tr>
              <td colspan="5" class="text-center text-muted py-4">No audit records found</td>
            </tr>
          {{ end }}
          </tbody>
        </table>
      </div>
    </div>
    {{ yield pagenav() }}
  </div>

  {{ end }}
{{ end }}
